---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { media } from '../data/media';

const groups = [
  { title: 'Financial Models', accent: 'top-gold', items: [
    { icon: 'chart', name: 'Cash Flow Forecast', desc: '13-week rolling cash flow model with built-in scenario planning triggers.', file: media.cashFlowModel.path, label: 'Download .XLSX' },
    { icon: 'sheet', name: 'P&L Analyzer', desc: 'Monthly profit and loss dashboard with variance analysis tabs.', file: media.pnlAnalyzer.path, label: 'Download .XLSX' },
    { icon: 'trend', name: 'Burn Rate Calculator', desc: 'Calculate your exact runway based on current spend and projected revenue.', file: media.burnRate.path, label: 'Download .XLSX' },
  ]},
  { title: 'Standard Operating Procedures', accent: 'top-soft', items: [
    { icon: 'document', name: 'Month-End Checklist', desc: 'The exact 5-day closing process used by bkept controllers.', file: media.monthEnd.path, label: 'Download PDF' },
    { icon: 'scale', name: 'Expense Policy', desc: 'Corporate expense reimbursement policy template for employees.', file: media.expensePolicy.path, label: 'Download PDF' },
    { icon: 'shield', name: 'Security Standards', desc: 'Data handling and password management guidelines for finance teams.', file: media.securityStandards.path, label: 'Download PDF' },
  ]},
] as const;
---
<Base title="The Library" description="Curated financial models, standard operating procedures, and calculators from bkept.">
  <div class="container">
    <section class="hero hero-full">
      <span class="eyebrow boxed">Client Access</span>
      <h1>The <span class="gold-text">Library.</span></h1>
      <p class="lead">Curated financial models, standard operating procedures, and calculators. Designed to bring immediate clarity to your back-office.</p>
    </section>
    {groups.map((g) => (
      <section class="section">
        <h2 class="group-title">{g.title}</h2>
        <div class="grid-3">
          {g.items.map((i) => (
            <div class={`card lift resource ${g.accent}`}>
              <div>
                <Icon name={i.icon} />
                <h3>{i.name}</h3>
                <p>{i.desc}</p>
              </div>
              <a href={i.file} class="download" download>{i.label}</a>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
