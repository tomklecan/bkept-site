---
import Base from '../layouts/Base.astro';
import Credentials from '../components/Credentials.astro';
import HeroServices from '../components/HeroServices.astro';
import Pathways from '../components/Pathways.astro';
import Founder from '../components/Founder.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import Icon from '../components/Icon.astro';
import CallBand from '../components/CallBand.astro';
import { site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'bkept',
  url: 'https://bkept.co/lbi/',
  description: 'bkept runs bookkeeping and accounting operations for seasonal businesses and real estate portfolios across Long Beach Island.',
  areaServed: ['Beach Haven, NJ', 'Surf City, NJ', 'Ship Bottom, NJ', 'Harvey Cedars, NJ', 'Barnegat Light, NJ'],
};
---
<Base
  title="Bookkeeping for Long Beach Island"
  description="Monthly bookkeeping, cleanups and QuickBooks setup for seasonal businesses and rental portfolios on Long Beach Island, with a lower dormant rate for the off-season."
  schema={schema}
>
  <div class="container">
    <section class="hero hero-full">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow rise">Fractional Accounting Operations</span>
          <h1 class="rise">Bookkeeping for <br /><span class="gold-text">Long Beach Island.</span></h1>
                    <p class="lead rise rise-3">A business on LBI runs on a 100-day season and a long quiet stretch. From busy restaurants in Beach Haven to rental portfolios in Barnegat Light, we keep the books current through the rush and pare back in the off-season.</p>
          <div class="hero-actions rise rise-4">
            <a href={site.introCallUrl} class="btn" target="_blank" rel="noopener">Book a 20-Minute Call</a>
            <Credentials />
          </div>
        </div>
        <HeroServices />
      </div>
    </section>
    <Pathways />
    <hr class="divider" />

    <section class="section" id="who-we-serve">
      <div class="section-head">
        <span class="eyebrow boxed">Who We Help</span>
        <h2 class="section-title">Built for the <br /><span class="gold-text">Shore.</span></h2>
        <p class="lead">We specialize in businesses that drive the local economy. Whether you manage a seasonal surge or year-round assets, we bring institutional discipline to your books.</p>
      </div>
      <div class="grid-3">
        <div class="card top-gold lift">
          <Icon name="dining" />
          <h4>Seasonal Hospitality</h4>
          <p>Restaurants, Retail, and Marinas. We track high-volume transactions in-season and offer flexible dormant pricing during the winter months.</p>
        </div>
        <div class="card top-gold lift">
          <Icon name="property" />
          <h4>Real Estate Holdings</h4>
          <p>Rental Portfolios and Property Management. We maintain strict ledger separation for individual assets and manage clean AP/AR workflows for rent collection.</p>
        </div>
        <div class="card top-gold lift">
          <Icon name="tools" />
          <h4>Local Services &amp; Trades</h4>
          <p>Construction, Contracting, and Marine Services. We track your project costs and vendor materials so you know exactly what your time and labor are worth.</p>
        </div>
      </div>
    </section>
    <hr class="divider" />
    <Founder />
    <hr class="divider" />
    <ServiceDetail />
  </div>
  <CallBand title="Get ahead of next season." text="A 20-minute call with Tom about your business, your season and your books. You leave knowing which retainer fits, including dormant-month pricing." />
</Base>
