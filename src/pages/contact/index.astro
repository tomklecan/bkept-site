---
import Base from '../../layouts/Base.astro';
import { desks, site } from '../../data/site';
---
<Base title="Contact" description="Contact bkept. Tell us about your business and we'll reply within one business day, or book a 20-minute call.">
  <div class="container">
    <section class="hero hero-full hero-center">
      <span class="eyebrow boxed">Contact the Firm</span>
      <h1>Operational Clarity.<br /><span class="gold-text">On Demand.</span></h1>
      <p class="lead">Your back office should not be a bottleneck. Tell us where things stand and we'll come back with next steps within {site.responseTime}.</p>
    </section>

    <div class="contact-grid">
      <div class="card top-gold">
        <form class="form" name="contact" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="company_website">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hp"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></p>
          <div class="form-row">
            <div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required /></div>
            <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          </div>
          <div class="form-row">
            <div class="field"><label for="business">Business name</label><input id="business" name="business" autocomplete="organization" /></div>
            <div class="field">
              <label for="topic">What can we help with?</label>
              <select id="topic" name="topic" required>
                <option value="new-client">Monthly bookkeeping (Kept)</option>
                <option value="function">Help with one function (AP/AR, payroll, sales tax)</option>
                <option value="project">One-time project, setup or cleanup (Concierge)</option>
                <option value="partnership">Partnership or referral</option>
                <option value="billing">Billing or existing account</option>
                <option value="other">Something else</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="volume">Roughly how many transactions a month?</label>
            <select id="volume" name="volume">
              <option value="">Not sure</option>
              <option>Up to 100</option>
              <option>101 to 500</option>
              <option>501 to 750</option>
              <option>More than 750</option>
            </select>
          </div>
          <div class="field"><label for="message">Where do things stand today?</label><textarea id="message" name="message" placeholder="Current software, how far behind the books are, what prompted you to reach out..."></textarea></div>
          <button type="submit" class="btn">Send to bkept</button>
        </form>
      </div>

      <aside>
        <div class="call-card">
          <h2>Rather talk it through?</h2>
          <p>Pick a time for a 20-minute call with Tom. You will leave knowing which retainer fits and what any catch-up work would cost.</p>
          <a href={site.introCallUrl} class="btn btn-gold btn-block" target="_blank" rel="noopener">Book a 20-Minute Call</a>
        </div>
        <h2 class="group-title" style="font-size:1.1rem;">Firm Directory</h2>
        <p class="muted" style="font-size:.95rem;">Prefer email? Write to the right desk and we will reply within {site.responseTime}.</p>
        {desks.map((d) => (
          <a class="desk" href={`mailto:${d.email}`}>
            <span class="desk-label">{d.label}</span>
            <span class="desk-email">{d.email}</span>
          </a>
        ))}
      </aside>
    </div>
  </div>
</Base>

<script>
  // Preselect the topic when arriving from a link like /contact/?topic=partnership
  const topic = new URLSearchParams(location.search).get('topic');
  const select = document.getElementById('topic') as HTMLSelectElement | null;
  if (topic && select && [...select.options].some((o) => o.value === topic)) select.value = topic;
</script>
