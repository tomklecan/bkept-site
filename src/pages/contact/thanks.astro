---
import Base from '../../layouts/Base.astro';
---
<Base title="Message received" noindex>
  <div class="container">
    <section class="hero hero-full hero-center" style="padding-block:120px;">
      <span class="eyebrow boxed">Received</span>
      <h1>Thank you. <span class="gold-text">We have it.</span></h1>
      <p class="lead">Your message is with our office. Expect a reply within one business day from a bkept.co address.</p>
      <div class="hero-actions" style="justify-content:center;"><a href="/" class="btn btn-outline">Back to home</a></div>
    </section>
  </div>
</Base>
