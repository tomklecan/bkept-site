---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
---
<Base title="Message received" noindex>
  <div class="container">
    <section class="hero hero-full hero-center" style="padding-block:120px;">
      <span class="eyebrow boxed">Received</span>
      <h1>Thank you. <span class="gold-text">We have it.</span></h1>
      <p class="lead">Your message is with our office. Expect a reply within one business day from a bkept.co address.</p>
      <p class="lead">Want to skip the back-and-forth? Pick a time for a 20-minute call now.</p>
      <div class="hero-actions" style="justify-content:center;"><a href={site.introCallUrl} class="btn" target="_blank" rel="noopener">Book a 20-Minute Call</a><a href="/" class="btn btn-outline">Back to home</a></div>
    </section>
  </div>
</Base>
