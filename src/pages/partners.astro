---
import Base from '../layouts/Base.astro';
---
<Base title="Partners" description="bkept works with CPAs, agencies and advisors who want their clients' books current, reviewed and ready when they need them.">
  <div class="container">
    <section class="hero hero-full hero-center">
      <span class="eyebrow boxed">Partners</span>
      <h1>Better <span class="gold-text">Together.</span></h1>
      <p class="lead">CPAs, agencies and advisors do their best work when a client's books are current and reviewed. We keep them that way, so the numbers you rely on are ready when you need them.</p>
      <div class="hero-actions" style="justify-content:center;">
        <a href="/contact/?topic=partnership" class="btn">Start a Partnership</a>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <span class="eyebrow boxed">How We Work Together</span>
        <h2 class="section-title">What You Can <span class="gold-text">Count On.</span></h2>
        <p class="lead">Referrals in both directions, or behind-the-scenes support for your own clients. We keep it simple.</p>
      </div>
      <div class="grid-3">
        <div class="card top-gold lift">
          <div class="num">01</div>
          <h4>Your Name Is Safe</h4>
          <p>When you refer a client, your reputation comes with them. We meet our deadlines and keep you informed, so the referral reflects well on you.</p>
        </div>
        <div class="card top-gold lift">
          <div class="num">02</div>
          <h4>Clean Numbers</h4>
          <p>Current, reviewed books make your work easier, whether you file the taxes, run the marketing or advise on strategy. Ask and we send what you need.</p>
        </div>
        <div class="card top-gold lift">
          <div class="num">03</div>
          <h4>We Stay in Our Lane</h4>
          <p>We run accounting operations. We do not file taxes, give legal advice or sell marketing, so your client relationship stays yours.</p>
        </div>
      </div>
    </section>
  </div>
</Base>
