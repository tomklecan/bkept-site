---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Client Insider" description="Access your bkept onboarding track, client hub, and firm materials." noindex>
  <div class="container">
    <section class="hero hero-full">
      <span class="eyebrow boxed">Secure Access</span>
      <h1>Client <span class="gold-text">Insider.</span></h1>
      <p class="lead">Your centralized command center. Access your onboarding track, continuous management hub, and firm materials to maintain your operational clarity.</p>
    </section>
    <section class="section">
      <div class="grid-3">
        <a href="/onboarding/" class="card top-gold lift resource">
          <div><Icon name="route" /><h3>Onboarding Track</h3><p>Navigate your 30-day integration timeline, submit master data, and review our operational cadence.</p></div>
          <span class="link-row">Open Onboarding <span class="arrow">→</span></span>
        </a>
        <div class="card top-soft resource" style="background:var(--surface);">
          <div><Icon name="lock" /><h3 class="muted">The Client Hub</h3><p>Your dedicated workspace for daily financial operations and monthly management review packages.</p></div>
          <span class="link-row disabled">Coming Soon</span>
        </div>
        <a href="/client-directory/" class="card top-gold lift resource">
          <div><Icon name="document" /><h3>Client Materials</h3><p>Portals, vendor forms, financial tools, and your monthly review booking link.</p></div>
          <span class="link-row">View Directory <span class="arrow">→</span></span>
        </a>
      </div>
    </section>
  </div>
</Base>
