---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <div class="container">
    <section class="hero hero-full hero-center" style="padding-block:120px;">
      <span class="eyebrow boxed">404</span>
      <h1>This page isn't <span class="gold-text">on the books.</span></h1>
      <p class="lead">The link may be old or mistyped. Start from the homepage or reach the office directly.</p>
      <div class="hero-actions" style="justify-content:center;">
        <a href="/" class="btn">Go to homepage</a>
        <a href="/contact/" class="btn btn-outline">Contact the Firm</a>
      </div>
    </section>
  </div>
</Base>
