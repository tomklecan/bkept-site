---
import Base from '../layouts/Base.astro';
import CallBand from '../components/CallBand.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
import { baseFee, baseIncludes, addOns, projectFrom, projects, dormantRate, fromPrice, usd } from '../data/pricing';
---
<Base title="Bookkeeping Pricing: Monthly Plans & Cleanup Costs" description={`bkept pricing: monthly bookkeeping retainers from ${usd(fromPrice)}/mo with add-ons for AP/AR, sales tax, analysis and budgeting, plus one-time projects from $500.`}>
  <div class="container">
    <section class="hero hero-full hero-center">
      <span class="eyebrow boxed">Pricing</span>
      <h1>Fixed Fees. <span class="gold-text">No Surprises.</span></h1>
      <p class="lead">One base fee for the monthly essentials, add-ons for the work you want handled, and one-time projects when something needs to be built or fixed. A 20-minute call sets your price.</p>
      <div class="cta-row"><a href={site.introCallUrl} class="btn" target="_blank" rel="noopener">Book a 20-Minute Call</a></div>
    </section>

    <div class="tracks">
      <div class="track card top-gold">
        <div class="track-head">
          <span class="tag">Monthly</span>
          <h2>Retainer Services</h2>
          <p>Your accounting run every month on a fixed calendar, for one fixed monthly fee. Start with the base and add what your business needs.</p>
        </div>

        <div class="tier">
          <div><div class="tier-name">Base Fee</div><div class="tier-details">The foundation of every retainer.</div></div>
          <div class="tier-price">{usd(baseFee)}<span>/mo</span></div>
        </div>
        <h3 class="subhead-rule">The Base Includes</h3>
        <ul class="def-list">
          {baseIncludes.map((i) => (<li><strong>{i.name}</strong> {i.details}</li>))}
        </ul>

        <h3 class="subhead-rule" id="add-ons" style="margin-top:25px;">Add-Ons</h3>
        <p class="muted">Add the work you want handled. Each is scoped to your business and quoted on the intro call, before you sign.</p>
        <ul class="def-list">
          {addOns.map((a) => (<li><strong>{a.name}</strong> {a.details}</li>))}
        </ul>
        <p class="note-box">Your monthly fee is set on a 20-minute call, based on the size of your business, how much runs through the books and the add-ons you choose. <strong>Seasonal businesses:</strong> a dormant rate from {usd(dormantRate)}/mo covers the off-season.</p>
      </div>
      <div class="track card top-ink">
        <div class="track-head">
          <span class="tag">One-Time</span>
          <h2>Project Services</h2>
          <p>Defined projects for when something needs to be built, moved or fixed, on their own or before monthly work begins. Fixed price or hourly, your choice.</p>
        </div>
        <div class="tier">
          <div><div class="tier-name">Projects</div><div class="tier-details">Quoted after a short scoping call.</div></div>
          <div class="tier-price">From {usd(projectFrom)}</div>
        </div>
        <h3 class="subhead-rule ink">Projects We Take On</h3>
        <ul class="def-list ink">
          {projects.map((p) => (<li><strong>{p.name}</strong> {p.details}</li>))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container"><Faq /></div>
  <CallBand title="Not sure where you fit?" text="Tell us roughly what the business brings in, what you want handled and how far behind the books are. On a 20-minute call we will give you a monthly price and quote any catch-up work as a flat fee." />
</Base>
