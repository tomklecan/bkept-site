---
import Base from '../layouts/Base.astro';
import Credentials from '../components/Credentials.astro';
import HeroServices from '../components/HeroServices.astro';
import Pathways from '../components/Pathways.astro';
import Icon from '../components/Icon.astro';
import CallBand from '../components/CallBand.astro';
import { site } from '../data/site';
import Founder from '../components/Founder.astro';
import ServiceDetail from '../components/ServiceDetail.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'bkept',
  url: 'https://bkept.co/westchester/',
  description: 'bkept runs bookkeeping and accounting operations for owner-led businesses across Westchester County.',
  areaServed: ['White Plains, NY', 'Pleasantville, NY', 'Mt. Kisco, NY', 'Tarrytown, NY', 'Rye, NY', 'Port Chester, NY'],
};
---
<Base
  title="Bookkeeping for Westchester County"
  description="Monthly bookkeeping, cleanups and QuickBooks setup for owner-led businesses across Westchester County. Books closed by the 10th, reviewed with you every month."
  schema={schema}
>
  <div class="container">
    <section class="hero hero-full">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="eyebrow rise">Fractional Accounting Operations</span>
          <h1 class="rise">Bookkeeping for <br /><span class="gold-text">Westchester County.</span></h1>
                    <p class="lead rise rise-3">From agencies in White Plains to consultants in Mt. Kisco and Pleasantville, we take the books off the owner's desk and run them on a fixed monthly calendar: reconciled, closed by the 10th, and reviewed with you.</p>
          <div class="hero-actions rise rise-4">
            <a href={site.introCallUrl} class="btn" target="_blank" rel="noopener">Book a 20-Minute Call</a>
            <Credentials />
          </div>
        </div>
        <HeroServices />
      </div>
    </section>
    <Pathways />
    <hr class="divider" />
    <section class="section" id="who-we-serve">
      <div class="section-head">
        <span class="eyebrow boxed">Who We Help</span>
        <h2 class="section-title">Built for <br /><span class="gold-text">Westchester Businesses.</span></h2>
        <p class="lead">Established, owner-led businesses that have outgrown doing the books themselves, from White Plains to Rye.</p>
      </div>
      <div class="grid-3">
        <div class="card top-gold lift">
          <Icon name="document" />
          <h4>Agencies &amp; Professional Services</h4>
          <p>Consultancies, creative agencies and specialist firms. Retainer revenue tracked cleanly, contractor costs categorized, and a monthly view of margin by client.</p>
        </div>
        <div class="card top-gold lift">
          <Icon name="property" />
          <h4>Real Estate &amp; Property</h4>
          <p>Rental portfolios and property managers. Each property kept on its own clean ledger, with rent collection and vendor payments on a set schedule.</p>
        </div>
        <div class="card top-gold lift">
          <Icon name="dining" />
          <h4>Hospitality &amp; Retail</h4>
          <p>Restaurants, studios and shops with high transaction volume. Daily sales and processor deposits reconciled, so the P&amp;L reflects what actually happened.</p>
        </div>
      </div>
    </section>
    <hr class="divider" />
    <Founder />
    <hr class="divider" />
    <ServiceDetail />
  </div>
  <CallBand title="Talk to a Westchester bookkeeper." text="A 20-minute call with Tom about your business and where the books stand. You leave knowing which retainer fits and what any catch-up would cost." />
</Base>
