---
import Base from '../layouts/Base.astro';
import Credentials from '../components/Credentials.astro';
import HeroServices from '../components/HeroServices.astro';
import Pathways from '../components/Pathways.astro';
import Founder from '../components/Founder.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import Testimonials from '../components/Testimonials.astro';
import CallBand from '../components/CallBand.astro';
import WhoWeServe from '../components/WhoWeServe.astro';
import CaseStudy from '../components/CaseStudy.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'AccountingService',
  name: 'bkept',
  url: site.url,
  description: site.defaultDescription,
  email: 'newclient@bkept.co',
  founder: { '@type': 'Person', name: 'Tom Klecan' },
  areaServed: ['Westchester County, NY', 'Long Beach Island, NJ', 'New York, NY'],
  sameAs: [site.linkedin],
};

const pains = [
  ['It gets done in bursts.', 'The books are caught up when someone finds a free weekend, then slide again until the next one.'],
  ['There is no set cadence.', 'No monthly close date, no reconciliation schedule, and no one checking that the work was done.'],
  ['Approvals happen from memory.', 'Bills get paid and expenses get coded without a review step or a record of who signed off.'],
  ['Nobody reviews the numbers.', 'Reports exist, but no one sits down each month to ask what they say about the business.'],
];

const shifts = [
  ['A fixed calendar', 'Reconciliations, the monthly close and your review happen on set dates, every month, whether or not it is a busy one.'],
  ['Someone to answer to', 'An outside firm holds the process to its standards and deadlines, and holds everyone who feeds it, owners included.'],
  ['A ripple effect', 'Once the numbers are current and reviewed, pricing, hiring and cash decisions get sharper across the whole business.'],
];

const month = [
  ['By the 4th', 'Accounts reconciled', 'Every bank and card account matched. Anything unclear comes to you as one short list, not a stream of emails.'],
  ['By the 10th', 'Books closed', 'Your P&L, Balance Sheet and Cash Flow Statement, closed and delivered.'],
  ['With the close', 'The Kept Memo', 'A plain-English summary of the month: what changed, what to watch, what needs a decision.'],
  ['Every month', 'A 1:1 review', 'Dedicated time with Tom to walk through the numbers and line them up with your plans.'],
];
---
<Base schema={schema}>
  <div class="container">
    <section class="hero hero-full">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="subhead rise">Fractional Accounting Operations</p>
          <h1 class="rise rise-2 one-line">Your Books, <span class="gold-text">Well Kept.</span></h1>
          <p class="lead rise rise-3">Your business finances, set up right and managed every month. One function, a one-time setup, or the whole back office: tell us what you need and we'll shape the engagement around it.</p>
          <div class="hero-actions rise rise-4">
            <a href={site.introCallUrl} class="btn" target="_blank" rel="noopener">Book a 20-Minute Call</a>
            <a href="/pricing/" class="btn btn-outline">See Pricing</a>
          </div>
          <div class="hero-badges rise rise-4">
            <Credentials />
          </div>
        </div>
        <HeroServices />
      </div>
    </section>

    <Pathways />
    <hr class="divider" />
    <WhoWeServe />
    <hr class="divider" />

    <section class="section" id="sound-familiar">
      <div class="section-head">
        <span class="eyebrow boxed">Sound Familiar?</span>
        <h2 class="section-title">Not a <span class="gold-text">Side Task.</span></h2>
        <p class="lead">In most small businesses, the books are kept by someone already stretched thin: the owner, an office manager, a part-time hire. It gets done, eventually. But without a cadence or a standard, it stays an afterthought.</p>
      </div>
      <ul class="pain-list">
        {pains.map(([k, v]) => <li><div><strong>{k}</strong><span>{v}</span></div></li>)}
      </ul>

      <div class="section-head" style="margin-top:70px;">
        <h3 class="section-title">A Higher <span class="gold-text">Standard.</span></h3>
        <p class="lead">When an independent firm runs your accounting, it stops being a chore someone squeezes in and becomes a real function of the business, with deliverables, deadlines and accountability.</p>
      </div>
      <div class="grid-3">
        {shifts.map(([k, v]) => (
          <div class="card top-gold">
            <h4>{k}</h4>
            <p>{v}</p>
          </div>
        ))}
      </div>
    </section>
    <hr class="divider" />


    <section class="section" id="every-month">
      <div class="section-head">
        <span class="eyebrow boxed">The Monthly Retainer</span>
        <h2 class="section-title">What to <span class="gold-text">Expect.</span></h2>
        <p class="lead">A fixed fee, a fixed calendar, and one person accountable for getting it done. Your books stay in your own QuickBooks, in your name.</p>
      </div>
      <div class="month">
        {month.map(([day, title, desc]) => (
          <div class="card top-gold">
            <span class="day">{day}</span>
            <h4>{title}</h4>
            <p>{desc}</p>
          </div>
        ))}
      </div>
      <div class="cta-row">
        <a href="/sample-memo/" class="btn">See a Sample Memo</a>
        <a href="/pricing/" class="btn btn-outline">See Retainer Pricing →</a>
      </div>
    </section>
    <hr class="divider" />

    <section class="section" id="how-it-starts">
      <div class="section-head">
        <span class="eyebrow boxed">Getting Started</span>
        <h2 class="section-title">How It <span class="gold-text">Starts.</span></h2>
      </div>
      <div class="steps">
        <div class="card">
          <span class="when">20 minutes</span>
          <h4>An intro call</h4>
          <p>We look at your current software, how many accounts you run, and how far behind the books are.</p>
        </div>
        <div class="card">
          <span class="when">After the call</span>
          <h4>A fixed quote</h4>
          <p>For whatever scope fits: a flat project fee, a monthly retainer, or both. No hourly billing surprises.</p>
        </div>
        <div class="card">
          <span class="when">First 30 days</span>
          <h4>The work begins</h4>
          <p>Projects start on an agreed timeline. Monthly clients get a 30-day onboarding, then the first close lands by the 10th.</p>
        </div>
      </div>
      <div class="cta-row">
        <a href={site.introCallUrl} class="btn" target="_blank" rel="noopener">Book a 20-Minute Call</a>
      </div>
    </section>
    <hr class="divider" />

    <Founder />
    <CaseStudy />
    <Testimonials />
    <hr class="divider" />
    <ServiceDetail />
    <hr class="divider" />
    <Faq />
  </div>
  <CallBand />
</Base>
