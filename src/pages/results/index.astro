---
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import CallBand from '../../components/CallBand.astro';
---
<Base title="Client Results" description="How bkept took a fast-growing e-commerce business from six months behind to daily processing and monthly reporting.">
  <div class="container">
    <section class="hero hero-full hero-center">
      <span class="eyebrow boxed">Client Results</span>
      <h1>Real <span class="gold-text">Results.</span></h1>
      <p class="lead">What changes when accounting becomes a real function of the business. Client names are left out; the work and the numbers are real.</p>
    </section>
    <CaseStudy />
  </div>
  <CallBand title="Sound like your business?" text="A 20-minute call with Tom. Tell us where the books stand today, and we'll show you what the first three months could look like." />
</Base>
