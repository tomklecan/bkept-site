---
import Base from '../../layouts/Base.astro';
import CallBand from '../../components/CallBand.astro';
import { caseStudies } from '../../data/caseStudies';
---
<Base title="Results" description="Case studies from bkept engagements: what the books looked like before, what changed, and what it meant for the business.">
  <div class="container">
    <section class="hero hero-full hero-center">
      <span class="eyebrow boxed">Results</span>
      <h1>Case <span class="gold-text">Studies.</span></h1>
      <p class="lead">Real engagements and what to expect, told plainly: where the books stand, what we change, and what it means for the business.</p>
    </section>

    <section class="section">
      <div class="grid-2">
        {caseStudies.map((c) => (
          <a href={`/results/${c.slug}/`} class="card top-gold lift case-card">
            <span class="eyebrow">{c.eyebrow}</span>
            <h3>{c.title}</h3>
            <p>{c.summary}</p>
            <span class="case-card-link">Read the Case Study →</span>
          </a>
        ))}
      </div>
    </section>
  </div>
  <CallBand title="Where do your books stand?" text="A 20-minute call with Tom. Tell us where things are today, and we'll show you what the first three months could look like." />
</Base>
