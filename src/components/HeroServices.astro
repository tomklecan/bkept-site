---
import Icon from './Icon.astro';
const items = [
  { icon: 'ledger', title: 'Monthly Bookkeeping', desc: 'Every account reconciled and your financials delivered by the 10th.' },
  { icon: 'chart', title: 'AP & AR Management', desc: 'Bills paid on schedule and invoices sent and tracked, so cash arrives on time.' },
  { icon: 'target', title: 'Cleanups & Catch-Up', desc: 'Months or years behind, brought current and tax-ready for a flat fee.' },
  { icon: 'sync', title: 'QuickBooks Setup', desc: 'A clean QuickBooks Online build or migration, structured for your business.' },
] as const;
---
<div class="mini-grid rise rise-4">
  {items.map((i) => (
    <div class="mini-card">
      <Icon name={i.icon} class="icon sm" />
      <h3>{i.title}</h3>
      <p>{i.desc}</p>
    </div>
  ))}
</div>
