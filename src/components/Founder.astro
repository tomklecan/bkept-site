---
import { media } from '../data/media';
import { site } from '../data/site';
---
<section class="section" id="founder">
  <span class="eyebrow boxed">About Us</span>
  <h2 class="section-title">The Founder’s <span class="gold-text">Advantage.</span></h2>
  <div class="founder-grid">
    <div class="founder-card">
      <img src={media.founder.path} alt="Tom Klecan, founder of bkept" width="140" height="140" loading="lazy" />
      <h3>Tom Klecan</h3>
      <span class="tag" style="display:block; margin-bottom:20px;">Founder &amp; Principal</span>
      <a href={site.linkedin} target="_blank" rel="noopener" class="btn btn-outline btn-block">Connect on LinkedIn</a>
    </div>
    <div class="founder-copy">
      <h3>Built on Entrepreneurial Spirit.</h3>
      <p>With a formal degree in accounting and a professional background managing financials for venture-backed NYC tech startups and global conglomerates like LVMH, Tom brings institutional discipline to private businesses. bkept was built to bridge the gap between basic data entry and high-level financial analysis.</p>
      <p>Operating as a full-spectrum partner, bkept goes beyond recording history. We act as an advocate for your reputation and a dedicated partner in your growth, managing your daily bookkeeping while delivering the technical accounting and reporting necessary to ensure your business thrives.</p>
      <div class="timeline">
        <div class="timeline-item">
          <span class="when">PRESENT</span>
          <h4>Founder &amp; Principal</h4>
          <span class="org">bkept. Financial Operations</span>
          <p>Accounting Operations Firm | Serving Private Businesses</p>
        </div>
        <div class="timeline-item">
          <span class="when">2020 — 2025</span>
          <h4>Accounting &amp; Controlling</h4>
          <span class="org">Global Premium Conglomerate</span>
          <p>US Holding Group | Group Owned E-Commerce Entity</p>
        </div>
        <div class="timeline-item">
          <span class="when">2014 — 2020</span>
          <h4>Accounting &amp; Operational Administration</h4>
          <span class="org">NYC Tech Startups</span>
          <p>Venture-Backed NYC Startups - SaaS, FinTech, Real Estate Tech</p>
        </div>
      </div>
    </div>
  </div>
</section>
