---
import { caseStudy as c } from '../data/caseStudy';
---
{c && (
  <section class="section" id="case-study">
    <div class="section-head">
      <span class="eyebrow boxed">Case Study</span>
      <h2 class="section-title">Before and <span class="gold-text">After.</span></h2>
      <p class="lead">{c.client}</p>
    </div>
    <div class="case-stats">
      {c.results.map((r) => (
        <div class="case-stat"><strong class="gold-text">{r.stat}</strong><span>{r.label}</span></div>
      ))}
    </div>
    <div class="grid-2">
      <div class="card top-ink">
        <h4>Where things stood</h4>
        <ul class="check-list">{c.before.map((b) => <li><span>{b}</span></li>)}</ul>
      </div>
      <div class="card top-gold">
        <h4>What we changed</h4>
        <ul class="check-list">{c.changes.map((b) => <li><span>{b}</span></li>)}</ul>
      </div>
    </div>
    {c.note && <p class="center muted case-note">{c.note}</p>}
  </section>
)}
