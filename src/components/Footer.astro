---
import { site, locations } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div>
      <span class="footer-brand">bkept.</span>
      <span class="footer-meta">© {year} {site.tagline}</span>
      <div class="footer-locs">
        <span>Operations:</span>
        {locations.map((loc, i) => (
          <>
            {i > 0 && <span aria-hidden="true">|</span>}
            <a href={loc.href}>{loc.label}</a>
          </>
        ))}
      </div>
    </div>
    <a href="/contact/" class="btn btn-gold">Contact the Firm</a>
  </div>
</footer>
